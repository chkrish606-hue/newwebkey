<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Key Store Panel</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #080b12;
      color: #f5f7fb;
      font-family: Arial, sans-serif;
    }

    .wrap {
      max-width: 1100px;
      margin: auto;
      padding: 22px;
    }

    .card {
      background: #101522;
      border: 1px solid #20293a;
      border-radius: 16px;
      padding: 20px;
      margin: 12px 0;
    }

    input,
    textarea,
    button,
    select {
      width: 100%;
      padding: 12px;
      margin: 7px 0;
      border-radius: 10px;
      border: 1px solid #30394b;
      background: #0b101a;
      color: white;
    }

    button {
      background: #7c3aed;
      border: 0;
      font-weight: 700;
      cursor: pointer;
    }

    button:hover {
      opacity: .9;
    }

    .danger {
      background: #b91c1c;
    }

    .ok {
      background: #15803d;
    }

    nav {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 16px;
    }

    nav button {
      width: auto;
    }

    .grid {
      display: grid;
      grid-template-columns:
        repeat(auto-fit, minmax(240px, 1fr));
      gap: 14px;
    }

    .muted {
      color: #9aa4b2;
    }

    .price {
      font-size: 20px;
      font-weight: 700;
      margin: 8px 0;
    }

    .key {
      padding: 10px;
      background: #090d15;
      border-radius: 9px;
      word-break: break-all;
      margin: 7px 0;
    }

    img {
      max-width: 100%;
      border-radius: 12px;
    }

    .small {
      font-size: 13px;
    }

    .hidden {
      display: none;
    }

    .center {
      max-width: 430px;
      margin: 70px auto;
    }

    h1,
    h2,
    h3 {
      margin-top: 0;
    }
  </style>
</head>

<body>

  <div class="wrap" id="app"></div>

  <script>

    const app = document.getElementById("app");

    const api = async (url, options = {}) => {

      options.headers = {
        ...(options.headers || {}),
        ...(localStorage.token
          ? {
              Authorization:
                "Bearer " + localStorage.token
            }
          : {})
      };

      const response = await fetch(url, options);

      const data = await response.json();

      if (!response.ok) {
        throw new Error(
          data.error || "Something went wrong"
        );
      }

      return data;
    };


    let me = null;


    function shell(content) {

      return `
        <nav>

          <button onclick="dashboard()">
            Store
          </button>

          <button onclick="keys()">
            My Keys
          </button>

          <button onclick="deposit()">
            Add Balance
          </button>

          <button onclick="profile()">
            Profile
          </button>

          ${
            me && me.role === "admin"
              ? `<button onclick="admin()">Admin</button>`
              : ""
          }

          <button onclick="logout()">
            Logout
          </button>

        </nav>

        ${content}
      `;
    }


    /* =========================
       LOGIN
    ========================== */

    function login() {

      app.innerHTML = `

        <div class="card center">

          <h1>Login</h1>

          <p class="muted">
            Key Store
          </p>

          <input
            id="email"
            type="email"
            placeholder="Email"
          >

          <input
            id="pass"
            type="password"
            placeholder="Password"
          >

          <button onclick="doLogin()">
            SIGN IN NOW
          </button>

          <button onclick="register()">
            CREATE NEW ACCOUNT
          </button>

          <button onclick="forgot()">
            Forgot Password?
          </button>

          <button onclick="googleDemo()">
            Continue with Google
          </button>

        </div>
      `;
    }


    async function doLogin() {

      try {

        const result = await api(
          "/api/login",
          {
            method: "POST",

            headers: {
              "Content-Type":
                "application/json"
            },

            body: JSON.stringify({
              email:
                document.getElementById("email").value,

              password:
                document.getElementById("pass").value
            })
          }
        );

        localStorage.token =
          result.token;

        await boot();

      } catch (error) {

        alert(error.message);

      }
    }


    /* =========================
       REGISTER
    ========================== */

    function register() {

      app.innerHTML = `

        <div class="card center">

          <h1>Create Account</h1>

          <input
            id="name"
            placeholder="Name"
          >

          <input
            id="email"
            type="email"
            placeholder="Email"
          >

          <input
            id="pass"
            type="password"
            placeholder="Password (6+ characters)"
          >

          <button onclick="doRegister()">
            CREATE ACCOUNT
          </button>

          <button onclick="login()">
            Back to Login
          </button>

        </div>
      `;
    }


    async function doRegister() {

      try {

        await api(
          "/api/register",
          {
            method: "POST",

            headers: {
              "Content-Type":
                "application/json"
            },

            body: JSON.stringify({

              name:
                document.getElementById("name").value,

              email:
                document.getElementById("email").value,

              password:
                document.getElementById("pass").value

            })
          }
        );

        alert(
          "Account created successfully."
        );

        login();

      } catch (error) {

        alert(error.message);

      }
    }


    /* =========================
       FORGOT PASSWORD
    ========================== */

    function forgot() {

      app.innerHTML = `

        <div class="card center">

          <h1>Forgot Password</h1>

          <p class="muted">
            Enter your registered email.
          </p>

          <input
            id="forgotEmail"
            type="email"
            placeholder="Registered Email"
          >

          <button onclick="sendOtp()">
            SEND OTP
          </button>

          <button onclick="login()">
            Back to Login
          </button>

        </div>
      `;
    }


    function sendOtp() {

      alert(
        "Real email OTP service will be connected before production."
      );

    }


    function googleDemo() {

      alert(
        "Google OAuth will be connected after Google OAuth credentials are configured."
      );

    }


    /* =========================
       CUSTOMER DASHBOARD
    ========================== */

    async function dashboard() {

      try {

        const products =
          await api("/api/products");

        let html = `

          <div class="card">

            <h2>
              Welcome,
              ${me.name || me.email}
            </h2>

            <p>
              Wallet:
              <strong>
                ₹${Number(me.wallet).toFixed(2)}
              </strong>
            </p>

          </div>

          <div class="grid">
        `;


        if (!products.length) {

          html += `
            <div class="card">
              <p class="muted">
                No products available.
              </p>
            </div>
          `;

        }


        products.forEach(product => {

          html += `

            <div class="card">

              ${
                product.image_url
                  ? `
                    <img
                      src="${product.image_url}"
                      alt="${product.name}"
                    >
                  `
                  : ""
              }

              <h2>
                ${product.name}
              </h2>

              <p class="muted">
                ${product.description || ""}
              </p>

          `;


          (product.plans || [])
            .forEach(plan => {

              let price =
                me.role === "reseller"
                  ? plan.reseller_price
                  : plan.customer_price;

              html += `

                <div class="card">

                  <b>
                    ${plan.name}
                  </b>

                  <div class="price">
                    ₹${Number(price).toFixed(2)}
                  </div>

                  <button
                    onclick="buy(${plan.id})"
                  >
                    BUY
                  </button>

                </div>

              `;

            });


          html += `
            </div>
          `;

        });


        html += `
          </div>
        `;


        app.innerHTML =
          shell(html);

      } catch (error) {

        alert(error.message);

      }
    }


    /* =========================
       BUY PRODUCT
    ========================== */

    async function buy(planId) {

      if (
        !confirm(
          "Do you want to purchase this plan?"
        )
      ) {
        return;
      }


      try {

        const result =
          await api(
            "/api/purchase",
            {
              method: "POST",

              headers: {
                "Content-Type":
                  "application/json"
              },

              body: JSON.stringify({
                plan_id: planId
              })
            }
          );


        alert(
          "Purchase successful!\n\nYour key:\n" +
          result.key
        );


        me =
          await api("/api/me");

        dashboard();

      } catch (error) {

        alert(error.message);

      }
    }


    /* =========================
       MY KEYS
    ========================== */

    async function keys() {

      try {

        const list =
          await api("/api/keys");


        let html = `

          <div class="card">

            <h2>
              My Keys
            </h2>

        `;


        if (!list.length) {

          html += `
            <p class="muted">
              No keys purchased yet.
            </p>
          `;

        }


        list.forEach(item => {

          html += `

            <div class="card">

              <b>
                ${item.product}
              </b>

              <div class="key">
                ${item.secret_key}
              </div>

            </div>

          `;

        });


        html += `
          </div>
        `;


        app.innerHTML =
          shell(html);

      } catch (error) {

        alert(error.message);

      }
    }


    /* =========================
       ADD BALANCE
    ========================== */

    function deposit() {

      app.innerHTML = shell(`

        <div class="card">

          <h2>
            Add Balance
          </h2>

          <p class="muted">
            Make your payment using the
            admin's UPI details and submit
            the transaction information.
          </p>

          <input
            id="amount"
            type="number"
            min="1"
            placeholder="Amount"
          >

          <input
            id="utr"
            placeholder="UTR / Transaction ID"
          >

          <input
            id="shot"
            type="file"
            accept="image/*"
          >

          <button onclick="sendDeposit()">
            SEND DEPOSIT REQUEST
          </button>

        </div>

      `);
    }


    async function sendDeposit() {

      try {

        const form =
          new FormData();


        form.append(
          "amount",
          document.getElementById("amount").value
        );


        form.append(
          "utr",
          document.getElementById("utr").value
        );


        const file =
          document.getElementById("shot")
            .files[0];


        if (file) {

          form.append(
            "screenshot",
            file
          );

        }


        await api(
          "/api/deposits",
          {
            method: "POST",
            body: form
          }
        );


        alert(
          "Deposit request sent to admin."
        );


        dashboard();

      } catch (error) {

        alert(error.message);

      }
    }


    /* =========================
       PROFILE
    ========================== */

    function profile() {

      app.innerHTML = shell(`

        <div class="card">

          <h2>
            Profile
          </h2>

          <p>
            Email:
            ${me.email}
          </p>

          <p>
            Role:
            <strong>
              ${me.role}
            </strong>
          </p>

          <p>
            Wallet:
            <strong>
              ₹${Number(me.wallet).toFixed(2)}
            </strong>
          </p>

          ${
            me.role === "customer"
              ? `
                <button
                  onclick="requestReseller()"
                >
                  Become D-Seller
                </button>
              `
              : ""
          }

        </div>

      `);
    }


    function requestReseller() {

      alert(
        "D-Seller registration/activation system will be connected to the admin-configurable fee."
      );

    }


    /* =========================
       ADMIN PANEL
    ========================== */

    async function admin() {

      try {

        const products =
          await api(
            "/api/admin/products"
          );


        const deposits =
          await api(
            "/api/admin/deposits"
          );


        let html = shell(`

          <div class="card">

            <h2>
              Admin Panel
            </h2>

          </div>


          <div class="card">

            <h3>
              Add Product
            </h3>

            <input
              id="productName"
              placeholder="Product Name"
            >

            <input
              id="productImage"
              placeholder="Product Image URL"
            >

            <textarea
              id="productDescription"
              placeholder="Product Description"
            ></textarea>

            <p class="muted small">
              Plans format:
              Plan Name | Customer Price | D-Seller Price
            </p>

            <textarea
              id="productPlans"
              rows="6"
              placeholder="1 Hour | 60 | 50
2 Hours | 100 | 80
3 Hours | 140 | 110"
            ></textarea>

            <button onclick="addProduct()">
              ADD PRODUCT
            </button>

          </div>


          <div class="card">

            <h3>
              Add Keys
            </h3>

            <input
              id="keyProductId"
              type="number"
              placeholder="Product ID"
            >

            <textarea
              id="keysBox"
              rows="10"
              placeholder="Paste keys here.
One key per line.
Each line = one key."
            ></textarea>

            <button onclick="addKeys()">
              ADD KEYS
            </button>

          </div>


          <div class="card">

            <h3>
              Products
            </h3>

            ${
              products.length
                ? products.map(product => `

                    <div class="card">

                      <b>
                        #${product.id}
                        ${product.name}
                      </b>

                      <p>
                        Available Keys:
                        ${product.available_keys}
                      </p>

                    </div>

                  `).join("")
                : `
                  <p class="muted">
                    No products.
                  </p>
                `
            }

          </div>


          <div class="card">

            <h3>
              Deposit Requests
            </h3>

            ${
              deposits.length
                ? deposits.map(item => `

                    <div class="card">

                      <b>
                        ${item.name ||
                        item.email}
                      </b>

                      <p>
                        Amount:
                        ₹${item.amount}
                      </p>

                      <p>
                        UTR:
                        ${item.utr || "-"}
                      </p>

                      <p>
                        Status:
                        <strong>
                          ${item.status}
                        </strong>
                      </p>

                      ${
                        item.status === "pending"
                          ? `

                            <button
                              class="ok"
                              onclick="reviewDeposit(
                                ${item.id},
                                'approve'
                              )"
                            >
                              APPROVE
                            </button>

                            <button
                              class="danger"
                              onclick="reviewDeposit(
                                ${item.id},
                                'reject'
                              )"
                            >
                              REJECT
                            </button>

                          `
                          : ""
                      }

                    </div>

                  `).join("")
                : `
                  <p class="muted">
                    No deposit requests.
                  </p>
                `
            }

          </div>

        `);


        app.innerHTML = html;

      } catch (error) {

        alert(error.message);

      }
    }


    /* =========================
       ADMIN ADD PRODUCT
    ========================== */

    async function addProduct() {

      try {

        const rawPlans =
          document.getElementById(
            "productPlans"
          ).value;


        const plans =
          rawPlans
            .split(/\r?\n/)
            .map(line => line.trim())
            .filter(Boolean)
            .map(line => {

              const parts =
                line.split("|");


              return {

                name:
                  (parts[0] || "").trim(),

                customer_price:
                  Number(
                    (parts[1] || "0").trim()
                  ),

                reseller_price:
                  Number(
                    (parts[2] || "0").trim()
                  )

              };

            });


        await api(
          "/api/admin/products",
          {
            method: "POST",

            headers: {
              "Content-Type":
                "application/json"
            },

            body: JSON.stringify({

              name:
                document.getElementById(
                  "productName"
                ).value,

              image_url:
                document.getElementById(
                  "productImage"
                ).value,

              description:
                document.getElementById(
                  "productDescription"
                ).value,

              plans

            })
          }
        );


        alert(
          "Product added successfully."
        );


        admin();

      } catch (error) {

        alert(error.message);

      }
    }


    /* =========================
       ADMIN ADD KEYS
    ========================== */

    async function addKeys() {

      try {

        const productId =
          document.getElementById(
            "keyProductId"
          ).value;


        const keys =
          document.getElementById(
            "keysBox"
          ).value;


        const result =
          await api(
            "/api/admin/keys",
            {
              method: "POST",

              headers: {
                "Content-Type":
                  "application/json"
              },

              body: JSON.stringify({

                product_id:
                  productId,

                keys

              })
            }
          );


        alert(
          result.added +
          " keys added successfully."
        );


        admin();

      } catch (error) {

        alert(error.message);

      }
    }


    /* =========================
       ADMIN DEPOSIT REVIEW
    ========================== */

    async function reviewDeposit(
      id,
      action
    ) {

      try {

        await api(
          "/api/admin/deposits/" +
          id +
          "/" +
          action,
          {
            method: "POST"
          }
        );


        alert(
          action === "approve"
            ? "Deposit approved."
            : "Deposit rejected."
        );


        admin();

      } catch (error) {

        alert(error.message);

      }
    }


    /* =========================
       LOGOUT
    ========================== */

    function logout() {

      localStorage.removeItem(
        "token"
      );

      me = null;

      login();

    }


    /* =========================
       START APP
    ========================== */

    async function boot() {

      if (!localStorage.token) {

        login();

        return;

      }


      try {

        me =
          await api("/api/me");

        dashboard();

      } catch (error) {

        logout();

      }

    }


    boot();

  </script>

</body>
</html>
